      "mtu_bytes": 1400,
      "packet_overhead_us": 0.15,
      "json_parse_ms_per_kb": 8e-05
    },
    "jsonrpc_latency_formula": "fixed_overhead + RTT + transfer_time(size/throughput) + packetization_overhead + json_cpu(size) + expected_retrans_penalty",
    "throughput_regimes_mbps": {
      "<=20MB": 9000.0,
      "20MB-100MB": 7500.0,
      "100MB-500MB": 6000.0,
      ">500MB": 5000.0
    },
    "calibration_note": "JSON-RPC path calibrated to practical 10GbE-class effective throughput with transport and parsing overhead."
  },
